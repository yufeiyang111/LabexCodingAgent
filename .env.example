# Backend database
LABEX_AGENT_DB_URL=jdbc:mysql://localhost:3306/labex_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
LABEX_AGENT_DB_USERNAME=root
LABEX_AGENT_DB_PASSWORD=change-me

# Backend auth
LABEX_AGENT_JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-bytes-2026-local-dev
LABEX_AGENT_JWT_EXPIRATION=86400000

# Credential encryption. Required in production: base64-encoded random 32-byte key.
# Local development uses a documented development fallback when this is empty.
LABEX_AGENT_SECRET_STORE_MASTER_KEY=

# Runtime storage
LABEX_AGENT_PROJECT_BASE_PATH=D:/LabexAgent/workspaces
LABEX_AGENT_UPLOAD_PATH=D:/LabexAgent/uploads
LABEX_AGENT_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required only with SPRING_PROFILES_ACTIVE=production (must be a prebuilt OCI image)
LABEX_AGENT_WORKER_DOCKER_IMAGE=

# Optional AI integrations
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M2.7-highspeed
TAVILY_API_KEY=

# Agent web search: Exa is primary; public search pages are a free fallback after recoverable Exa failures.
# Parallel is never selected automatically and requires explicit enablement or provider=parallel.
LABEX_AGENT_WEB_SEARCH_PROVIDER=auto
LABEX_AGENT_WEB_SEARCH_EXA_ENABLED=true
LABEX_AGENT_WEB_SEARCH_PARALLEL_ENABLED=false
LABEX_AGENT_WEB_SEARCH_PUBLIC_FALLBACK_ENABLED=true
EXA_API_KEY=
PARALLEL_API_KEY=
LABEX_AGENT_WEB_SEARCH_TIMEOUT_SECONDS=25
LABEX_AGENT_WEB_SEARCH_MAX_RESPONSE_BYTES=1048576

# Optional language servers
LABEX_LSP_JAVA_CMD=jdtls
LABEX_LSP_TS_CMD=typescript-language-server --stdio
LABEX_LSP_VUE_CMD=vue-language-server --stdio
LABEX_LSP_PY_CMD=pyright-langserver --stdio
