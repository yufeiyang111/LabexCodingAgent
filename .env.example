# Backend database
LABEX_AGENT_DB_URL=jdbc:mysql://localhost:3306/labex_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
LABEX_AGENT_DB_USERNAME=root
LABEX_AGENT_DB_PASSWORD=change-me

# Backend auth
LABEX_AGENT_JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-bytes-2026-local-dev
LABEX_AGENT_JWT_EXPIRATION=86400000

# 认证安全配置（生产环境需要可连通的 Redis）。
LABEX_AGENT_AUTH_REDIS_URL=redis://127.0.0.1:6379
LABEX_AGENT_AUTH_REDIS_TIMEOUT=2s
LABEX_AGENT_AUTH_REDIS_CONNECT_TIMEOUT=2s
LABEX_AGENT_AUTH_LOGIN_RATE_LIMIT=10
LABEX_AGENT_AUTH_OAUTH_EXCHANGE_RATE_LIMIT=10
LABEX_AGENT_AUTH_REGISTER_RATE_LIMIT=5
LABEX_AGENT_AUTH_CAPTCHA_RATE_LIMIT=20
LABEX_AGENT_AUTH_LOGIN_FAILURE_THRESHOLD=3
LABEX_AGENT_AUTH_REGISTER_CAPTCHA_THRESHOLD=3
LABEX_AGENT_AUTH_FAILURE_WINDOW_SECONDS=300
LABEX_AGENT_AUTH_CAPTCHA_TTL_SECONDS=120
LABEX_AGENT_AUTH_GITHUB_CLIENT_ID=
LABEX_AGENT_AUTH_GITHUB_CLIENT_SECRET=
LABEX_AGENT_AUTH_GOOGLE_CLIENT_ID=
LABEX_AGENT_AUTH_GOOGLE_CLIENT_SECRET=
LABEX_AGENT_AUTH_OAUTH_CALLBACK_BASE_URL=http://localhost:8080/api/auth/oauth
LABEX_AGENT_AUTH_OAUTH_FRONTEND_CALLBACK=http://localhost:3000/login
# 可选；留空时从 LABEX_AGENT_AUTH_OAUTH_FRONTEND_CALLBACK 自动推导 /projects
LABEX_AGENT_AUTH_OAUTH_BINDING_FRONTEND_CALLBACK=

# Credential encryption. Required in production: base64-encoded random 32-byte key.
# Local development uses a documented development fallback when this is empty.
LABEX_AGENT_SECRET_STORE_MASTER_KEY=

# Runtime storage
LABEX_AGENT_PROJECT_BASE_PATH=D:/LabexAgent/workspaces
LABEX_AGENT_UPLOAD_PATH=D:/LabexAgent/uploads
LABEX_AGENT_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Windows 公网 Tunnel 覆盖项（启用公网入口时，将以下值同步到本机 .env）。
# SERVER_ADDRESS=127.0.0.1
# LABEX_AGENT_CORS_ALLOWED_ORIGINS=https://labexagent.123845.xyz
# LABEX_AGENT_WEBSOCKET_ALLOWED_ORIGINS=https://labexagent.123845.xyz

# Default only for newly created Agent conversations. Existing conversations and resumed tasks keep their persisted profile.
LABEX_AGENT_RUNTIME_PROFILE_DEFAULT=labex-legacy
# Agent loop finalization guard. One retry is allowed only when the durable completion evidence is unchanged.
LABEX_AGENT_FINALIZATION_RECOVERY_LIMIT=1

# Outer model-turn watchdog in milliseconds. Set 0 to disable only this outer deadline;
# the selected provider still owns its connection, header, read, and stream timeouts.
LABEX_AGENT_MODEL_TURN_TOTAL_TIMEOUT_MS=300000
# Legacy history/checkpoint reader removal gate. Do not shorten the observation window in production without evidence.
LABEX_AGENT_LEGACY_REMOVAL_VERSION=1.1.0
LABEX_AGENT_LEGACY_OBSERVATION_WINDOW_DAYS=14

# Required only with SPRING_PROFILES_ACTIVE=production (must be a prebuilt OCI image)
LABEX_AGENT_WORKER_DOCKER_IMAGE=

# Standard managed shell profile. Use safe only for legacy direct-command compatibility;
# full_access additionally requires an explicit unsafe-local opt-in.
LABEX_AGENT_PERMISSION_PROFILE=labex-standard

# Sandbox network is enabled by default (WSL/Docker workers get network without approval).
# Set to false to restore the offline-first sandbox.
LABEX_AGENT_WORKER_NETWORK_DEFAULT_ENABLED=true

# Managed preview services use a dedicated long-running Worker process and require sandbox networking.
LABEX_AGENT_PREVIEW_ENABLED=true
LABEX_AGENT_PREVIEW_STARTUP_TIMEOUT_MS=30000
LABEX_AGENT_PREVIEW_POLL_INTERVAL_MS=250
LABEX_AGENT_PREVIEW_CONNECT_TIMEOUT_MS=1000
LABEX_AGENT_PREVIEW_OUTPUT_MAX_CHARS=60000
# 预览启动失败时返回给 Agent 的已脱敏 stdout/stderr 尾部上限；完整日志仍保存在 preview artifact。
LABEX_AGENT_PREVIEW_FAILURE_HINT_MAX_CHARS=512
# 预览进程退出或停止后，等待 stdout/stderr 读取完成的最长时间（毫秒）。
LABEX_AGENT_PREVIEW_OUTPUT_DRAIN_TIMEOUT_MS=1000
LABEX_AGENT_PREVIEW_MIN_PORT=1024
LABEX_AGENT_PREVIEW_MAX_PORT=65535
LABEX_AGENT_PREVIEW_READINESS_HOST=127.0.0.1
LABEX_AGENT_PREVIEW_PUBLIC_HOST=localhost

# Linux Web 生产部署的完整示例与校验说明见 deploy/linux/：
# - deploy/linux/.env.production.example（production 必填项）
# - deploy/linux/README.md（拓扑与安全要点）
# production profile 会在启动前校验：DB 凭据、JWT ≥64 字节、Secret Store 主密钥、
# CORS/WebSocket 仅 HTTPS 来源、Linux 路径（不允许 D:/... 盘符）、拒绝 full_access。

# Optional AI integrations
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M2.7-highspeed
TAVILY_API_KEY=

# Agent web search: Exa is primary; public search pages are a free fallback after recoverable Exa failures.
# Parallel is never selected automatically and requires explicit enablement or provider=parallel.
LABEX_AGENT_WEB_SEARCH_PROVIDER=auto
LABEX_AGENT_WEB_SEARCH_EXA_ENABLED=true
LABEX_AGENT_WEB_SEARCH_PARALLEL_ENABLED=false
LABEX_AGENT_WEB_SEARCH_PUBLIC_FALLBACK_ENABLED=true
EXA_API_KEY=
PARALLEL_API_KEY=
LABEX_AGENT_WEB_SEARCH_TIMEOUT_SECONDS=25
LABEX_AGENT_WEB_SEARCH_MAX_RESPONSE_BYTES=1048576

# Agent web fetch: resource limits protect the server before result text is reduced for the model.
LABEX_AGENT_WEB_FETCH_CONNECT_TIMEOUT_SECONDS=20
LABEX_AGENT_WEB_FETCH_REQUEST_TIMEOUT_SECONDS=60
LABEX_AGENT_WEB_FETCH_MAX_REDIRECTS=5
LABEX_AGENT_WEB_FETCH_MAX_RESPONSE_BYTES=1048576
LABEX_AGENT_WEB_FETCH_DEFAULT_MAX_CHARS=12000
LABEX_AGENT_WEB_FETCH_MIN_MAX_CHARS=1000
LABEX_AGENT_WEB_FETCH_MAX_MAX_CHARS=50000

# Optional language servers
LABEX_LSP_JAVA_CMD=jdtls
LABEX_LSP_TS_CMD=typescript-language-server --stdio
LABEX_LSP_VUE_CMD=vue-language-server --stdio
LABEX_LSP_PY_CMD=pyright-langserver --stdio

# Agent temporary image attachments; terminal task files expire after 24 hours
LABEX_AGENT_ATTACHMENT_PATH=D:/LabexAgent/uploads/agent-input-attachments
LABEX_AGENT_ATTACHMENT_MAX_FILES_PER_MESSAGE=4
LABEX_AGENT_ATTACHMENT_MAX_FILE_SIZE_BYTES=20971520
LABEX_AGENT_ATTACHMENT_MAX_TOTAL_SIZE_BYTES=41943040
LABEX_AGENT_ATTACHMENT_PENDING_TTL_MINUTES=15
LABEX_AGENT_ATTACHMENT_TERMINAL_TTL_HOURS=24
# Estimated visual-input budget per OpenAI-compatible image data URL; provider actual usage remains authoritative
LABEX_AGENT_ATTACHMENT_ESTIMATED_IMAGE_TOKENS=8192

# 历史消息单页事件预算与工具输出截断（可选）
LABEX_AGENT_HISTORY_MAX_PAGE_EVENTS_BUDGET=1000
LABEX_AGENT_HISTORY_MAX_PART_OUTPUT_CHARS=4000
# 单次 read_tool_output 返回的 UTF-16 字符上限；模型可使用 next_offset 继续分页读取。
LABEX_AGENT_TOOL_OUTPUT_READ_MAX_CHARS=4000
# Maximum safe workspace-relative candidates returned after read_file cannot find a path.
LABEX_AGENT_READ_FILE_CANDIDATE_LIMIT=3
# 仅用于发送给大模型的 AgentRunPart 输出投影行数上限。
# 对齐 OpenCode 的 2000 行与 51200 字节 UTF-8 输出边界；完整落库内容可通过 read_tool_output 分页取回。
LABEX_AGENT_TOOL_OUTPUT_MODEL_MAX_LINES=2000
LABEX_AGENT_TOOL_OUTPUT_MODEL_MAX_BYTES=51200

# Site monitoring dashboard: /ops page shows traffic (PV/UV) and server metrics.
# No visible entry point; open http://<host>/ops directly and enter the access code.
# Leave LABEX_AGENT_MONITOR_ACCESS_CODE empty to disable the monitor gate.
LABEX_AGENT_MONITOR_ENABLED=true
LABEX_AGENT_MONITOR_ACCESS_CODE=
LABEX_AGENT_MONITOR_SESSION_TTL_HOURS=24
LABEX_AGENT_MONITOR_AUTH_RATE_LIMIT=5
LABEX_AGENT_MONITOR_AUTH_FAILURE_WINDOW_SECONDS=300
LABEX_AGENT_MONITOR_DETAIL_RETENTION_DAYS=30
LABEX_AGENT_MONITOR_STATS_RETENTION_DAYS=180

# Offline IP geolocation for monitor visitor tracing (ip2region xdb, local lookup, no outbound IP)
LABEX_AGENT_MONITOR_GEO_ENABLED=true
LABEX_AGENT_MONITOR_GEO_XDB_PATH=classpath:ip2region_v4.xdb
LABEX_AGENT_MONITOR_GEO_CACHE_SIZE=4096

# Monitor dependency health checks (/ops/health). timeouts in milliseconds.
LABEX_AGENT_MONITOR_HEALTH_TIMEOUT_MS=3000
LABEX_AGENT_MONITOR_HEALTH_EXECUTOR_POOL_SIZE=4
LABEX_AGENT_MONITOR_HEALTH_PROBE_TIMEOUT_MS=5000

# Monitor Agent runtime query (/ops/runtime). paging and projection limits.
LABEX_AGENT_MONITOR_RUNTIME_DEFAULT_PAGE_SIZE=20
LABEX_AGENT_MONITOR_RUNTIME_MAX_PAGE_SIZE=200
LABEX_AGENT_MONITOR_RUNTIME_EVENT_TIMELINE_LIMIT=50
LABEX_AGENT_MONITOR_RUNTIME_EVENT_TIMELINE_MAX_LIMIT=500
LABEX_AGENT_MONITOR_RUNTIME_EVENT_PAYLOAD_MAX_CHARS=2000
LABEX_AGENT_MONITOR_RUNTIME_SUMMARY_MAX_CHARS=200

