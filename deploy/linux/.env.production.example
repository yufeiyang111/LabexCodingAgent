# LabexAgent Linux Web 生产部署环境变量示例。
# 复制为 .env.production 并填写真实值；ProductionStartupValidator 会在缺失时启动前失败。
# 启动：docker compose --env-file .env.production up -d

# --- 发布版本与域名（Compose 必填） ---
LABEX_AGENT_PUBLIC_HOST=labexagent.123845.xyz
LABEX_AGENT_BACKEND_IMAGE=labex-agent-backend:2026-08-19
# 服务器执行：stat -c '%g' /var/run/docker.sock
LABEX_AGENT_DOCKER_SOCKET_GID=999
# Docker daemon 在宿主机上看到的真实工作区根目录；后端容器内路径会自动映射到这里。
LABEX_AGENT_DOCKER_HOST_WORKSPACE_BASE_PATH=/srv/labex-agent/data/workspaces

# --- 数据库（必填） ---
LABEX_AGENT_DB_URL=jdbc:mysql://127.0.0.1:3306/labex_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
LABEX_AGENT_DB_USERNAME=labex
LABEX_AGENT_DB_PASSWORD=replace-with-real-db-password

# --- 密钥（必填） ---
# 生成：openssl rand -base64 64
LABEX_AGENT_JWT_SECRET=replace-with-base64-64-bytes
# 生成：openssl rand -base64 32
LABEX_AGENT_SECRET_STORE_MASTER_KEY=replace-with-base64-32-bytes

# --- 认证限流与图形验证码（必填） ---
# docker-compose.yml 中的 Redis service 会覆盖为 redis://redis:6379。
LABEX_AGENT_AUTH_REDIS_URL=redis://redis:6379
LABEX_AGENT_AUTH_LOGIN_RATE_LIMIT=10
LABEX_AGENT_AUTH_REGISTER_RATE_LIMIT=5
LABEX_AGENT_AUTH_LOGIN_FAILURE_THRESHOLD=3
LABEX_AGENT_AUTH_REGISTER_CAPTCHA_THRESHOLD=3
LABEX_AGENT_AUTH_OAUTH_CALLBACK_BASE_URL=https://labexagent.123845.xyz/api/auth/oauth
LABEX_AGENT_AUTH_OAUTH_FRONTEND_CALLBACK=https://labexagent.123845.xyz/login
LABEX_AGENT_AUTH_OAUTH_BINDING_FRONTEND_CALLBACK=https://labexagent.123845.xyz/projects
LABEX_AGENT_AUTH_GITHUB_CLIENT_ID=
LABEX_AGENT_AUTH_GITHUB_CLIENT_SECRET=
LABEX_AGENT_AUTH_GOOGLE_CLIENT_ID=
LABEX_AGENT_AUTH_GOOGLE_CLIENT_SECRET=

# --- 隔离 Worker（必填，生产拒绝 smoke 镜像） ---
# 固定 tag/digest，不允许 latest 作为生产唯一输入。
LABEX_AGENT_WORKER_DOCKER_IMAGE=labex-agent-sandbox:2026-08-19

# --- 来源与路径（必填） ---
# 只允许实际 HTTPS 域名，逗号分隔，不允许 `*` 或 http://。
LABEX_AGENT_CORS_ALLOWED_ORIGINS=https://labexagent.123845.xyz
LABEX_AGENT_WEBSOCKET_ALLOWED_ORIGINS=https://labexagent.123845.xyz
LABEX_AGENT_PROJECT_BASE_PATH=/srv/labex-agent/workspaces
LABEX_AGENT_UPLOAD_PATH=/srv/labex-agent/uploads

# --- 权限与资源（生产不允许 full_access） ---
LABEX_AGENT_PERMISSION_PROFILE=opencode
LABEX_AGENT_NETWORK_DEFAULT_ENABLED=true
LABEX_AGENT_WORKER_CPU_MILLIS=1000
LABEX_AGENT_WORKER_MEMORY_MB=512
LABEX_AGENT_WORKER_MAX_PIDS=256
LABEX_AGENT_DOCKER_MAX_CONCURRENT_CONTAINERS=1

# --- 上传限制（显式化，前端由 Nginx 同样限制） ---
# spring.servlet.multipart.max-file-size=100MB / max-request-size=100MB
# （在 application.yml 中已显式配置，Nginx 侧 client_max_body_size 必须一致）

# --- 站点运维监控（可选；默认关闭，需配置校验码） ---
# 配置 LABEX_AGENT_MONITOR_ACCESS_CODE 后，https://<host>/ops 可用（无显式入口）。
LABEX_AGENT_MONITOR_ENABLED=true
LABEX_AGENT_MONITOR_ACCESS_CODE=replace-with-a-strong-access-code
LABEX_AGENT_MONITOR_SESSION_TTL_HOURS=24
LABEX_AGENT_MONITOR_AUTH_RATE_LIMIT=5
LABEX_AGENT_MONITOR_AUTH_FAILURE_WINDOW_SECONDS=300
LABEX_AGENT_MONITOR_DETAIL_RETENTION_DAYS=30
LABEX_AGENT_MONITOR_STATS_RETENTION_DAYS=180
# 离线 IP 归属地（ip2region xdb 已打进后端镜像，本地查询，不外发访客 IP）
LABEX_AGENT_MONITOR_GEO_ENABLED=true
LABEX_AGENT_MONITOR_GEO_XDB_PATH=classpath:ip2region_v4.xdb
LABEX_AGENT_MONITOR_GEO_CACHE_SIZE=4096


