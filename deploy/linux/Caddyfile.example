# LabexAgent Caddy 等价配置示例（T3.3）。
# Caddy 自动申请/续期 Let's Encrypt 证书；若使用受管证书请移除 tls 内部配置。
# 复制为 Caddyfile 后：caddy validate --config Caddyfile

agent.example.com {
	# 上传与请求体：与后端 100MB 限制一致。
	request_body {
		max_size 100MB
	}

	encode zstd gzip

	# ---- 静态前端：/ 提供 frontend/dist，SPA 路由回退 index.html ----
	root * /usr/share/caddy
	try_files {path} /index.html
	file_server

	# ---- API 代理：/api/ → Spring Boot（context-path /api）----
	handle /api/* {
		# SSE：Caddy 默认流式透传，无需额外 buffering 配置；
		# 显式关闭 request buffering 并放宽超时。
		reverse_proxy backend:8080 {
			header_up X-Forwarded-Proto https
			# WebSocket Upgrade 自动支持（PTY 恢复后直接可用）。
		}
	}
}
