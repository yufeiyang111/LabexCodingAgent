{$LABEX_AGENT_PUBLIC_HOST} {
	request_body {
		# 浏览器上传走分片（默认 8 MiB/片），单片远低于这里；该上限只挡整包投递
		# 与其它接口的异常大请求。数值必须与后端 spring.servlet.multipart 同源（同一环境变量）。
		max_size {$LABEX_AGENT_PROJECT_ARCHIVE_MAX_BYTES:524288000}
	}

	encode zstd gzip

	# API、SSE 和 WebSocket 统一交给 Spring Boot。
	handle /api/* {
		reverse_proxy backend:8080
	}

	# 其余路径由 Vue SPA 提供，前端路由回退到 index.html。
	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
