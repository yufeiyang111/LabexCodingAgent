{$LABEX_AGENT_PUBLIC_HOST} {
	request_body {
		# 必须与后端 spring.servlet.multipart 的 max-file-size 同源（同一个环境变量）。
		# 注意：Caddy 的 413 是它自己的错误页，拿不到后端的 JSON 提示；
		# 因此超过上限时的「上限多少、超了多少」由前端预校验与后端解压阶段负责。
		max_size {$LABEX_AGENT_PROJECT_ARCHIVE_MAX_BYTES:524288000}
	}

	encode zstd gzip

	# API、SSE 和 WebSocket 统一交给 Spring Boot。
	handle /api/* {
		reverse_proxy backend:8080
	}

	# 其余路径由 Vue SPA 提供，前端路由回退到 index.html。
	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
