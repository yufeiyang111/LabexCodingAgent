node_modules/
.npm-cache/

# Build outputs
dist/
dist-*/
frontend/dist*/
target/

# Runtime data
workspaces/
uploads/
logs/

# Local configuration
.env
.env.*
!.env.example

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Test output
frontend/test-output.txt
frontend/frontend-test-output.txt
/frontend-test-output.txt
/frontend-build-final.txt

# Local UI previews and diff review scratch files (not part of the project)
/agent-ui-demo.html
/labex-ui-redesign.html
/design/
/.tmp-diff-review.txt
/.labex-agent-focused-diff.txt

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local recovery and debugging archive
/local-recovery-debug-archive/

# Local agent and session artifacts
.labex*/*
.superpowers/
.claude/
.workbuddy/

# .labex-agent project configuration: only the non-secret project/ subtree is version-visible.
# Ignore the contents first, then re-include exactly the allowed non-secret project config paths.
!.labex-agent/project/
.labex-agent/project/*
!.labex-agent/project/agent.json
!.labex-agent/project/agents/
!.labex-agent/project/tools/
!.labex-agent/project/mcp/
!.labex-agent/project/skills/
!.labex-agent/project/environment.json

# Personal private docs
docs/个人资料/

# Project documentation (keep in repo separately)
LabexAgent.md
CLAUDE.md

# docs: entire directory is private and never pushed to the repository
docs/

# Native Windows sandbox helper: keep build output and generated binaries ignored; helper source, contract and test fixtures stay visible
sandbox/windows-helper/build*/
sandbox/windows-helper/**/*.exe
sandbox/windows-helper/**/*.dll
sandbox/windows-helper/**/*.pdb
sandbox/windows-helper/**/*.obj
sandbox/windows-helper/**/*.lib

# AI agent scratch and dev-server artifacts
.codex-tmp/
vite.config.js.timestamp-*

# 本机后端启动产物：由 scripts/capture_backend_cmdline.ps1 生成，含本机绝对路径与完整 classpath，
# 换机器无意义；start_backend.ps1 依赖它复现原启动方式。
backend/current_cmdline.txt

# Deploy release archives
deploy/linux/*.tar
deploy/linux/*.tar.gz
deploy/linux/*.sql
deploy/linux/release/
deploy/linux/archive-inputs.txt
